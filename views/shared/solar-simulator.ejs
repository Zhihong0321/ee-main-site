<%- include('partials/b2b-head', { extraCss: '/css/simulator.css', preloadHero: false, schemaData: null }) %>
<body>
<script>document.documentElement.classList.add('js')</script>

<header class="sim-hero">
  <%- include('partials/b2b-nav', { anchorBase: '/' }) %>
  <div class="sim-hero-in wrap">
    <h1><span class="ln"><span>Your bill after solar,</span></span><span class="ln"><span>simulated from the tariff.</span></span></h1>
    <p class="lede">Most solar quotes multiply your bill by a saving percentage. The Eternalgy Solar Simulator, built in-house by our software team, does the arithmetic instead: it rebuilds your TNB bill from the tariff, follows every kilowatt-hour your system generates, and calculates the bill you will pay after solar, item by item.</p>
  </div>
</header>

<main>
  <section class="tool wrap" id="simulate" aria-labelledby="tool-h">
    <form class="sim-form" id="simform" action="/solar-simulator#simulate" method="get" novalidate>
      <h2 id="tool-h" class="h-head">Simulate your bill</h2>
      <p class="hint">For homes on TNB's domestic tariff. For a business bill, <a class="tlink" href="/#contact">request an assessment</a>.</p>

      <label class="fld" for="amount">Monthly TNB bill (RM)
        <input id="amount" name="amount" type="number" inputmode="decimal" min="50" max="5000" step="1" value="500" required aria-describedby="amount-help amount-err">
      </label>
      <p class="help" id="amount-help">The ringgit amount on your latest bill, RM50 to RM5,000.</p>
      <p class="err" id="amount-err" role="alert" hidden></p>

      <label class="fld" for="afa">Bill month
        <select id="afa" name="afa" aria-describedby="afa-help">
          <% afaMonths.forEach(function(m) { %>
            <option value="<%= m.value %>" <%= m.label === 'Apr 2026' ? 'selected' : '' %>><%= m.label %> (fuel surcharge <%= m.sen %> sen/kWh)</option>
          <% }); %>
        </select>
      </label>
      <p class="help" id="afa-help">The month printed on the bill, so its fuel surcharge is applied.</p>

      <fieldset class="seg">
        <legend>Supply phase</legend>
        <label><input type="radio" name="phase" value="3" checked> 3-phase</label>
        <label><input type="radio" name="phase" value="1"> 1-phase</label>
      </fieldset>
      <fieldset class="seg">
        <legend>Inverter</legend>
        <label><input type="radio" name="inverter" value="string" checked> String</label>
        <label><input type="radio" name="inverter" value="hybrid"> Hybrid</label>
      </fieldset>

      <button class="btn" type="submit" id="go">Simulate my bill</button>
    </form>

    <div class="sim-out" id="out" aria-live="polite">
      <div class="placeholder" id="placeholder">
        <p class="big">RM361.58</p>
        <p>saved a month on a RM500 April 2026 bill, three-phase, string inverter: RM504.67 becomes RM143.09.</p>
        <p class="muted">Enter your own bill to see yours, rebuilt line by line.</p>
      </div>
      <div id="result" hidden>
        <p class="kicker" id="r-input"></p>
        <p class="big" id="r-saving"></p>
        <p class="sub">estimated saving a month</p>
        <p class="pay"><span id="r-before"></span> <span aria-hidden="true">→</span> <span id="r-pay"></span> <span class="muted">both at a zero fuel surcharge</span></p>

        <div class="figs">
          <div><b id="r-kwp"></b><span id="r-panels"></span></div>
          <div><b id="r-gen"></b><span>generated a month at 3.4 sun-peak hours</span></div>
          <div><b id="r-used"></b><span>used as it is generated</span></div>
        </div>

        <h3>Where the solar goes</h3>
        <div class="flow" id="r-flow" role="img"></div>
        <ul class="flow-legend" id="r-flow-legend"></ul>

        <h3>The bill is recalculated, not discounted</h3>
        <table class="bill">
          <thead><tr><th scope="col">Component</th><th scope="col">Before</th><th scope="col">After solar</th></tr></thead>
          <tbody id="r-items"></tbody>
          <tfoot>
            <tr><th scope="row">Bill at the new usage</th><td id="r-b1"></td><td id="r-a1"></td></tr>
            <tr><th scope="row" id="r-credit-label">Export credit</th><td></td><td id="r-credit"></td></tr>
            <tr class="total"><th scope="row">You pay</th><td id="r-b2"></td><td id="r-a2"></td></tr>
          </tfoot>
        </table>
        <div class="acts">
          <a class="btn" id="r-wa" href="https://wa.me/601121000099" target="_blank" rel="noopener">Book a site survey</a>
          <span class="muted">A forecast, not a guarantee. We confirm it with a site survey and up to twelve months of bills.</span>
        </div>
      </div>
      <p class="err" id="out-err" role="alert" hidden></p>
    </div>
  </section>

  <section class="steps6 wrap" aria-labelledby="flow-h">
    <h2 id="flow-h" class="h-head">From your bill to your saving</h2>
    <ol class="six">
      <li><h3>Your bill</h3><p>The ringgit amount and the month on your TNB bill.</p></li>
      <li><h3>Tariff match</h3><p>The usage that produces that bill under TNB's tariff, with that month's surcharge.</p></li>
      <li><h3>System size</h3><p>Panels sized to your usage at Malaysian sun-peak hours.</p></li>
      <li><h3>Energy flow</h3><p>Used on site, exported, or beyond the credit cap.</p></li>
      <li><h3>New bill</h3><p>Every component recalculated at your new usage.</p></li>
      <li><h3>Your saving</h3><p>Old bill minus new bill, plus the export credit.</p></li>
    </ol>
  </section>

  <section class="models wrap" aria-labelledby="models-h">
    <div>
      <h2 id="models-h" class="h-head">What the engine models</h2>
      <ul class="plain">
        <li>TNB's residential tariff in force since 1 July 2025, line by line: energy, capacity, network and retail charges</li>
        <li>TNB's low-voltage commercial tariff</li>
        <li>Sixteen months of fuel surcharge (AFA), July 2025 to October 2026</li>
        <li>SST and retail-charge thresholds, and the energy efficiency incentive (EEI) bands</li>
        <li>ATAP export rules: credit capped at what is imported, no roll-over</li>
        <li>Battery capacity, depth of discharge and charging losses</li>
        <li>Commercial load, hour by hour, against opening hours</li>
      </ul>
    </div>
    <div class="matters">
      <h2 class="h-sub">Why the method matters</h2>
      <p>Solar is a 25-year asset. A saving overstated by RM150 a month is not a small error: it repeats every month the system runs.</p>
      <table class="cmp">
        <caption>Illustration: a RM45,000 system</caption>
        <thead><tr><th scope="col"></th><th scope="col">Saving promised</th><th scope="col">Saving achieved</th></tr></thead>
        <tbody>
          <tr><th scope="row">Monthly saving</th><td>RM600</td><td>RM450</td></tr>
          <tr><th scope="row">Simple payback</th><td>6.3 years</td><td>8.3 years</td></tr>
          <tr><th scope="row">20-year saving, no tariff increase</th><td>RM144,000</td><td>RM108,000</td></tr>
          <tr class="total"><th scope="row">Expectation gap over 20 years</th><td colspan="2">RM36,000</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="biz" aria-labelledby="biz-h">
    <div class="wrap biz-in">
      <div>
        <h2 id="biz-h" class="h-head">For business,<br>hour by hour.</h2>
        <p>A worked example: a RM5,000 bill on TNB's low-voltage general commercial tariff matches 9,671 kWh a month. The simulator splits that into a round-the-clock load and an operating load over your opening hours, then sets each hour's solar against that hour's load.</p>
        <div class="figs dark">
          <div><b>45.5 kWp</b><span>70 × 650 W panels</span></div>
          <div><b>4,601 kWh</b><span>used on site a month</span></div>
          <div><b>RM2,387.14</b><span>saved a month: RM4,999.68 → RM2,612.54</span></div>
        </div>
      </div>
      <div>
        <h3>Share of a day's solar, 7 am to 5 pm</h3>
        <div class="curve" role="img" aria-label="Solar generation by hour: 2% at 7 am rising to 16% at noon and falling to 2% at 5 pm">
          <% [['7',2],['8',5],['9',9],['10',12],['11',15],['12',16],['1',15],['2',12],['3',8],['4',4],['5',2]].forEach(function(h) { %>
            <div class="bar" style="--v:<%= h[1] %>"><span class="v"><%= h[1] %>%</span><span class="h"><%= h[0] %></span></div>
          <% }); %>
        </div>
        <h3>Same bill, closed at weekends</h3>
        <table class="cmp dark">
          <tbody>
            <tr><th scope="row">Open every day, 8 am–6 pm</th><td>RM2,387.14 saved a month</td></tr>
            <tr><th scope="row">Open Monday to Friday</th><td>RM1,978.92 saved a month; 1,383 kWh exported</td></tr>
          </tbody>
        </table>
        <p class="muted-dark">Closed at weekends, the same panels export most of their output at the lower export rate. The simulator shows the difference instead of hiding it.</p>
      </div>
    </div>
  </section>

  <section class="hold wrap" aria-labelledby="hold-h">
    <h2 id="hold-h" class="h-head">Why the numbers hold up</h2>
    <div class="hold-grid">
      <article><h3>It starts from the real bill</h3><p>The bill is matched to the usage that produces it under TNB's current tariff, so the simulation knows the usage instead of guessing it from a percentage.</p></article>
      <article><h3>It applies the bill month's surcharge</h3><p>The fuel surcharge (AFA) changes every month. Using the one on the bill stops the same ringgit being read as the wrong usage.</p></article>
      <article><h3>It rebuilds the bill after solar</h3><p>Energy, network, capacity, retail, SST, KWTBB and the efficiency rebate are recalculated at the new usage. Tariff bands and tax thresholds fall away as they would on a real bill.</p></article>
      <article><h3>It follows every kilowatt-hour</h3><p>Solar used on site saves the full tariff. Exported solar earns only the export rate, only up to what is imported that month; the rest expires, as under ATAP.</p></article>
      <article><h3>It models business hours</h3><p>Commercial premises are simulated hour by hour against opening hours and round-the-clock load, so a shop closed on Sunday shows a smaller saving.</p></article>
      <article><h3>It shows its working</h3><p>Every component is on screen, before and after. The customer can check the arithmetic, and so can their bank.</p></article>
    </div>
    <table class="cmp wide">
      <thead><tr><th scope="col"></th><th scope="col">Percentage estimate</th><th scope="col">Eternalgy bill simulation</th></tr></thead>
      <tbody>
        <tr><th scope="row">Starting point</th><td>Bill × an assumed saving %</td><td>The bill matched to usage under TNB's tariff</td></tr>
        <tr><th scope="row">Fuel surcharge</th><td>Ignored</td><td>The bill month's AFA applied</td></tr>
        <tr><th scope="row">Daytime use and export</th><td>Treated as equal</td><td>Valued separately: full tariff vs export rate</td></tr>
        <tr><th scope="row">Export limit</th><td>Usually ignored</td><td>Credit capped at what is imported; the rest expires</td></tr>
        <tr><th scope="row">Bill after solar</th><td>Old bill minus the percentage</td><td>Recalculated component by component</td></tr>
        <tr><th scope="row">Tax and rebate thresholds</th><td>Ignored</td><td>SST, retail charge and EEI follow the new usage</td></tr>
        <tr><th scope="row">Business hours</th><td>Ignored</td><td>Hour by hour against the opening hours</td></tr>
      </tbody>
    </table>
    <div class="cannot">
      <h3>What a simulation cannot know</h3>
      <p>Weather and season, the roof's direction and shading, changes in how much power is used, and future tariffs and rules. The simulator gives a detailed forecast, not a guarantee. We confirm it with a site survey and, ideally, up to twelve months of bills before you commit.</p>
      <p class="muted">Figures from the Eternalgy Solar Simulator, TNB tariff in force October 2026.</p>
    </div>
  </section>

  <section class="cta wrap" id="contact" aria-labelledby="cta-h">
    <h2 id="cta-h" class="h-head">Own your power.<br>Own your future.</h2>
    <div>
      <p>Share your site address and electricity bills. Our engineers recommend the scheme that fits your load profile and return a system design, yield and payback.</p>
      <div class="acts"><a class="btn" href="https://wa.me/601121000099?text=Hi%20Eternalgy%2C%20I%27d%20like%20a%20site%20assessment%20for%20solar%20PV." target="_blank" rel="noopener">Request a site assessment</a><a class="tlink" href="mailto:admin@eternalgy.com">admin@eternalgy.com</a><a class="tlink" href="tel:+601121000099">+60 11-2100 0099</a></div>
    </div>
  </section>
</main>

<%- include('partials/b2b-footer') %>

<script>
(function(){
  var f=document.getElementById('simform'),go=document.getElementById('go'),amt=document.getElementById('amount');
  var aErr=document.getElementById('amount-err'),oErr=document.getElementById('out-err');
  var ph=document.getElementById('placeholder'),res=document.getElementById('result');
  var rm=function(v){return 'RM'+Number(v).toLocaleString('en-MY',{minimumFractionDigits:2,maximumFractionDigits:2})};
  var kwh=function(v){return Math.round(Number(v)).toLocaleString('en-MY')+' kWh'};
  var $=function(id){return document.getElementById(id)};
  amt.addEventListener('input',function(){aErr.hidden=true;amt.removeAttribute('aria-invalid')});
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var a=parseFloat(amt.value);
    if(!(a>=50&&a<=5000)){aErr.textContent='Enter a monthly bill between RM50 and RM5,000.';aErr.hidden=false;amt.setAttribute('aria-invalid','true');amt.focus();return}
    var q=new URLSearchParams({amount:a,afa:$('afa').value,phase:f.phase.value,inverter:f.inverter.value});
    go.disabled=true;go.textContent='Simulating…';oErr.hidden=true;
    fetch('/api/simulate?'+q).then(function(r){return r.json().then(function(b){return{ok:r.ok,b:b}})}).then(function(x){
      if(!x.ok){throw new Error(x.b.error||'The simulator could not calculate this bill.')}
      var i=x.b.input,r=x.b.result;
      $('r-input').textContent=rm(i.amount)+' bill, '+i.month+', '+i.phase+'-phase, '+i.inverter+' inverter';
      $('r-saving').textContent=rm(r.monthlySaving);
      $('r-before').textContent=rm(r.billBefore);$('r-pay').textContent=rm(r.youPay);
      $('r-kwp').textContent=r.systemSizeKwp+' kWp';$('r-panels').textContent=r.panels+' × '+r.panelWatts+' W panels';
      $('r-gen').textContent=kwh(r.generationKwh);
      $('r-used').textContent=r.generationKwh?Math.round(100*r.usedOnSiteKwh/r.generationKwh)+'%':'–';
      var tot=r.usedOnSiteKwh+r.exportedKwh+r.beyondCapKwh||1,parts=[['used','Used as it is generated, saving the full tariff',r.usedOnSiteKwh],['exp','Exported, credited at RM'+r.exportRate.toFixed(4)+'/kWh',r.exportedKwh],['cap','Beyond the credit cap, earning nothing',r.beyondCapKwh]];
      $('r-flow').innerHTML=parts.map(function(p){return '<span class="seg-'+p[0]+'" style="flex-grow:'+Math.max(p[2],0)+'"></span>'}).join('');
      $('r-flow').setAttribute('aria-label',parts.map(function(p){return p[1]+': '+kwh(p[2])}).join('; '));
      $('r-flow-legend').innerHTML=parts.map(function(p){return '<li><i class="seg-'+p[0]+'"></i>'+p[1]+': <b>'+kwh(p[2])+'</b></li>'}).join('');
      var names={usage:'Energy charge',network:'Network charge',capacity:'Capacity charge',sst:'SST',eei:'EEI rebate',afa:'Fuel surcharge (AFA)'};
      $('r-items').innerHTML=r.items.filter(function(it){return it.key!=='afa'}).map(function(it){return '<tr><th scope="row">'+(names[it.key]||it.label)+'</th><td>'+rm(it.before)+'</td><td>'+rm(it.after)+'</td></tr>'}).join('');
      $('r-b1').textContent=rm(r.billBefore);$('r-a1').textContent=rm(r.billAfterAtNewUsage);
      $('r-credit-label').textContent='Export credit, '+kwh(r.exportedKwh)+' × RM'+r.exportRate.toFixed(4);$('r-credit').textContent='−'+rm(r.exportCredit);
      $('r-b2').textContent=rm(r.billBefore);$('r-a2').textContent=rm(r.youPay);
      $('r-wa').href='https://wa.me/601121000099?text='+encodeURIComponent('Hi Eternalgy, my TNB bill is '+rm(i.amount)+' ('+i.month+'). The website simulator shows about '+rm(r.monthlySaving)+' a month saving. I would like a site survey.');
      ph.hidden=true;res.hidden=false;
    }).catch(function(err){oErr.textContent=err.message;oErr.hidden=false}).finally(function(){go.disabled=false;go.textContent='Simulate my bill'});
  });
  document.querySelectorAll('.menu-d .panel a').forEach(function(a){a.addEventListener('click',function(){a.closest('details').removeAttribute('open')})});
})();
</script>
</body>
</html>
