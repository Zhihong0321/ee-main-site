<script>
(function(){
  var note=document.getElementById('capnote');
  document.querySelectorAll('.group li').forEach(function(li){var s=function(){note.textContent=li.dataset.d};li.addEventListener('mouseenter',s);li.addEventListener('focus',s)});
  var shot=document.getElementById('shot');
  document.querySelectorAll('.srow').forEach(function(r){var s=function(){if(shot.getAttribute('src')!==r.dataset.img){shot.style.opacity=0;setTimeout(function(){shot.src=r.dataset.img;shot.alt=r.dataset.alt;shot.style.opacity=1},180)}};r.addEventListener('mouseenter',s);r.addEventListener('focus',s)});
  document.querySelectorAll('.menu-d .panel a').forEach(function(a){a.addEventListener('click',function(){a.closest('details').removeAttribute('open')})});
  document.querySelectorAll('main h2, .row, .group, .srow, .step, .band .cap p, .nrow, .offices p, .cta p').forEach(function(el){el.classList.add('rv')});
  var els=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  els.forEach(function(el,i){el.style.transitionDelay=(i%4*80)+'ms';io.observe(el)});
})();
</script>
