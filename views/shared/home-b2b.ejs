        <tr><td class="num">2025</td><td>MyHijau certified equipment</td><td>MGTC · SAJ inverter range</td><td class="num">MyHS00025/25</td></tr>
        <tr class="gap"><td colspan="4"></td></tr>
        <tr><td class="num">2024</td><td>Registered PV Service Provider</td><td>SEDA Malaysia</td><td class="num">SEDA/RPVSP/2024/321</td></tr>
        <tr><td></td><td>Registered PV Investor</td><td>SEDA Malaysia</td><td>RPVI directory</td></tr>
        <tr><td></td><td>Golden Bull, Outstanding Bull</td><td>Malaysia Golden Bull Award</td><td>Awarded</td></tr>
        <tr class="gap"><td colspan="4"></td></tr>
        <tr><td>Partners</td><td>SAJ Malaysia sole distributor</td><td>SAJ Electric · Shanghai</td><td>50 MW + 10 MWh</td></tr>
        <tr><td></td><td>Selected solar PV partner</td><td>Maybank</td><td>Preferred installer</td></tr>
        <tr><td></td><td>Centre of Excellence partner</td><td>SHRDC Shah Alam</td><td>Battery training</td></tr>
        <tr><td></td><td>Corporate member</td><td>Malaysian Photovoltaic Industry Association</td><td>MPiA</td></tr>
      </tbody>
    </table>
  </section>

  <section class="acct wrap" aria-labelledby="acct-h">
    <h2 id="acct-h" class="h-head">One contractor,<br>accountable.</h2>
    <div class="points">
      <article class="point rv"><h3>Zero sub-contractors</h3><p>Electrical and structural engineering, installation and service by our own staff.</p></article>
      <article class="point rv"><h3>Workmanship guaranteed</h3><p>1-year leak-proof workmanship guarantee and 3-year MSIG Solar All-Risk Insurance on every installation.</p></article>
      <article class="point rv"><h3>Supply chain we control</h3><p>Sole distributor for SAJ in Malaysia, with warehouses in Johor and Selangor for fast replacement.</p></article>
      <article class="point rv"><h3>Safety to listed-company standard</h3><p>An OSH-C certified supervisor on our own payroll, on every major site.</p></article>
    </div>
  </section>

  <%
    // Engineering notes lead; news fills the remaining rows.
    const insightTips = (tips || []).slice(0, 4).map(t => Object.assign({ kind: 'Engineering' }, t));
    const insights = insightTips.concat(
      (news || []).slice(0, 6 - insightTips.length).map(n => Object.assign({ kind: 'News' }, n))
    );
  %>
  <section class="notes wrap" id="insights" aria-labelledby="ins-h">
    <h2 id="ins-h" class="h-head">Insights</h2>
    <div>
      <% insights.forEach(function(item) { %>
        <div class="nrow"><a href="/<%= item.slug %>"><%= item.title %></a><span><%= item.kind %></span></div>
      <% }); %>
      <a class="tlink more" href="/tips">All engineering notes</a>
      &nbsp;&nbsp;<a class="tlink more" href="/news">Energy news</a>
    </div>
  </section>

  <section class="cta wrap" id="contact" aria-labelledby="cta-h">
    <h2 id="cta-h" class="h-head">Request a site<br>assessment.</h2>
    <div>
      <p>Send your site address and twelve months of TNB bills. Our engineers return a feasibility study with system size, yield and payback.</p>
      <div class="acts"><a class="btn" href="https://wa.me/601121000099?text=Hi%20Eternalgy%2C%20I%27d%20like%20a%20site%20assessment%20for%20solar%20PV." target="_blank" rel="noopener">Request an assessment</a><a class="tlink" href="mailto:enquiry@eternalgy.me">enquiry@eternalgy.me</a><a class="tlink" href="tel:+601121000099">+60 11-2100 0099</a></div>
    </div>
  </section>
</main>

