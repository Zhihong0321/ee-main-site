<%- include('partials/header') %>

<section class="section wrap">
  <div class="sec-head">
    <span class="eyebrow">Frequently Asked Questions</span>
    <h1 class="h-sec">Solar PV FAQ</h1>
    <p class="sec-head__r lede">Essential solar installation details in Malaysia—covering Solar ATAP rules, SuRIA cash rebates, three-phase grid upgrades, Monier tile leakage, and equipment warranties.</p>
  </div>

  <% const catNames = {
    financial: '💰 Financial & Payback',
    technical: '⚙️ Technical & Inverters',
    structural: '🏠 Structural & Leakage',
    policy: '📋 Policy & Solar ATAP'
  } %>

  <div style="display: grid; gap: 32px; margin-top: 24px;">
    <% Object.entries(grouped).forEach(function([category, list]) { %>
      <% if (list && list.length > 0) { %>
        <div class="reveal" style="border-top: 1px solid var(--line); padding-top: 20px;">
          <span class="eyebrow no-tick" style="font-size: 11px; color: var(--accent-deep); margin-bottom: 16px;"><%= catNames[category] || category.toUpperCase() %></span>
          
          <div style="display: grid; gap: 16px; margin-top: 12px;">
            <% list.forEach(function(faq) { %>
              <article style="background: var(--panel); border: 1px solid var(--line); padding: 20px; display: flex; flex-direction: column; gap: 12px;">
                <h3 style="font-family: var(--font-display); font-size: 16px; font-weight: 500; color: var(--ink); line-height: 1.3; display: flex; gap: 8px; align-items: flex-start; margin: 0;">
                  <span style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-deep); background: var(--paper); padding: 1px 6px; border: 1px solid var(--line); border-radius: 4px; flex-shrink: 0;">Q</span>
                  <%= faq.question %>
                </h3>
                <div class="article-body" style="border-left: 2px solid var(--line-strong); padding-left: 14px; margin-left: 10px; font-size: 14px; color: var(--ink-2); line-height: 1.5;">
                  <%- faq.html_answer %>
                </div>
              </article>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% }); %>
  </div>
</section>

<%- include('partials/footer') %>
