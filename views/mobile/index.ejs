<%- include('partials/header') %>

<!-- ============ HERO ============ -->
<section class="hero section wrap">
  <div class="hero__grid"></div>
  <div class="hero__inner">
    <span class="eyebrow">Solar EPC · Engineering</span>
    <h1 class="display">Solar,<br>engineered<br>to <span class="mark">last.</span></h1>
    <% if (companyAbout) { %>
      <p class="lede" style="margin-top:22px;"><%= companyAbout.summary || "Eternalgy designs, installs and maintains commercial & industrial solar PV with one accountable, first-party engineering team." %></p>
    <% } else { %>
      <p class="lede" style="margin-top:22px;">Eternalgy designs, installs and maintains commercial &amp; industrial solar PV with one accountable, first-party engineering team.</p>
    <% } %>
    <div class="hero__actions">
      <a class="btn" href="#contact">Talk to an engineer ↗</a>
      <a class="btn btn--ghost" href="#services">Our services</a>
    </div>
    <figure class="media" style="aspect-ratio: 16/12; margin-top:30px;">
      <img src="/images/eternalgy-rooftop-hero-v1.webp" width="1600" height="854" alt="Aerial view of a commercial rooftop solar PV installation in Malaysia" fetchpriority="high" decoding="async">
    </figure>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="stats" aria-label="Track record">
  <div class="stats__grid">
    <div class="stat"><div class="stat__num">1.65<span class="u">MWp</span></div><div class="stat__label">Deployed solar PV</div></div>
    <div class="stat"><div class="stat__num">501</div><div class="stat__label">Managed PV sites</div></div>
    <div class="stat"><div class="stat__num">1.65<span class="u">GWh</span></div><div class="stat__label">Lifetime generation</div></div>
    <div class="stat"><div class="stat__num">24<span class="u">+</span></div><div class="stat__label">EV charging stations</div></div>
    <div class="stat"><div class="stat__num">60<span class="u">+</span></div><div class="stat__label">Staff &amp; contractors</div></div>
    <div class="stat"><div class="stat__num">4</div><div class="stat__label">Offices nationwide</div></div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section wrap" id="services">
  <div class="sec-head">
    <span class="eyebrow">Our line of business</span>
    <h2 class="h-sec">Six capabilities, one integrated team.</h2>
    <p class="sec-head__r lede">Every discipline sits in-house — so one team is accountable for your system end to end. No finger-pointing.</p>
  </div>
  <div class="svc">
    <article class="svc__item reveal"><span class="svc__no">01</span><h3 class="svc__title">Solar PV System</h3><p class="svc__desc">Full EPC for C&amp;I rooftops and ground mount — design, engineering, supply and installation.</p><div class="svc__tags">EPC · C&amp;I · DESIGN</div></article>
    <article class="svc__item reveal"><span class="svc__no">02</span><h3 class="svc__title">Solar PV Investment</h3><p class="svc__desc">Zero-capex solar. We fund, build and operate; you buy clean power at a lower rate.</p><div class="svc__tags">RPVI · PPA · ZERO-CAPEX</div></article>
    <article class="svc__item reveal"><span class="svc__no">03</span><h3 class="svc__title">Solar PV O&amp;M</h3><p class="svc__desc">Monitoring, cleaning, fault response and reporting that keeps systems at spec.</p><div class="svc__tags">MONITORING · UPTIME</div></article>
    <article class="svc__item reveal"><span class="svc__no">04</span><h3 class="svc__title">EV Charging</h3><p class="svc__desc">AC and DC charging infrastructure, integrated with solar and load management.</p><div class="svc__tags">AC · DC · INTEGRATION</div></article>
    <article class="svc__item reveal"><span class="svc__no">05</span><h3 class="svc__title">Electrical Engineering</h3><p class="svc__desc">In-house, first-party electrical works — switchgear, cabling and grid interconnection.</p><div class="svc__tags">CIDB G3 · LICENSED</div></article>
    <article class="svc__item reveal"><span class="svc__no">06</span><h3 class="svc__title">Software Engineering</h3><p class="svc__desc">Our own platforms for generation monitoring, inventory and logistics.</p><div class="svc__tags">PLATFORM · DATA</div></article>
  </div>
</section>

<!-- ============ WHY ============ -->
<section class="why section wrap" id="why">
  <span class="eyebrow">Why Eternalgy</span>
  <h2 class="h-sec">No ball-kicking. One team owns it.</h2>
  <p class="lede">The industry's common failure is finger-pointing between vendors. Our engineers are first-party — so accountability never leaves the building.</p>
  <div class="why__points">
    <div class="point reveal"><div class="point__n">01</div><div class="point__t">First-party engineers</div><p class="point__d">Design, installation and resolution under one roof — from drawing to decades of operation.</p></div>
    <div class="point reveal"><div class="point__n">02</div><div class="point__t">SAJ sole distributor</div><p class="point__d">We control the supply chain — MyHijau-certified inverters and fast, direct replacement.</p></div>
    <div class="point reveal"><div class="point__n">03</div><div class="point__t">Digitalised logistics</div><p class="point__d">Two warehouses and automated stock-keeping mean minimal downtime and fast installs.</p></div>
    <div class="point reveal"><div class="point__n">04</div><div class="point__t">Built for the long run</div><p class="point__d">O&amp;M and live monitoring hold systems to design output — protecting your return.</p></div>
  </div>
</section>

<!-- ============ PROJECTS ============ -->
<section class="section wrap" id="projects-cases">
  <div class="sec-head">
    <span class="eyebrow">Case Studies</span>
    <h2 class="h-sec">Commissioned Installations</h2>
    <p class="sec-head__r lede">Our commercial rooftop and utility-scale solar PV track record.</p>
  </div>
  <div class="inno">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(function(project) { %>
        <article class="inno__card reveal">
          <span class="inno__tag">📍 <%= project.location %> · <%= project.capacity_kwp %> kWp</span>
          <h3 class="inno__h"><%= project.title %></h3>
          <p class="inno__p" style="font-size: 14px; color: var(--soft); margin-top: 8px;"><%= project.summary %></p>
          <figure class="media" style="aspect-ratio: 16/9; margin-top: 20px; margin-bottom: 20px;">
            <img src="/images/eternalgy-commercial-project-v1.webp" width="1500" height="844" alt="Commissioned <%= project.capacity_kwp %> kWp commercial rooftop solar installation in <%= project.location %>" loading="lazy" decoding="async">
          </figure>
          <a class="btn btn--ghost" href="/<%= project.slug %>">View Case Study ↗</a>
        </article>
      <% }); %>
    <% } else { %>
      <p>No projects commissioned yet.</p>
    <% } %>
  </div>
</section>

<!-- ============ PRODUCTS CATALOGUE ============ -->
<section class="section wrap" id="hardware" style="background: var(--panel); margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad);">
  <div class="sec-head">
    <span class="eyebrow">Hardware Catalogue</span>
    <h2 class="h-sec">Premium Components</h2>
    <p class="sec-head__r lede">Tier-1 hardware featuring TOPCon bifacial modules, smart stackable hybrid storage batteries, and commercial inverter systems.</p>
  </div>
  <div class="cert-grid">
    <% if (products && products.length > 0) { %>
      <% products.forEach(function(product) { %>
        <div class="cert reveal" style="min-height: 190px;">
          <div>
            <span class="eyebrow no-tick" style="font-size: 9px; margin-bottom: 4px;"><%= product.brand %></span>
            <div class="cert__name" style="font-size: 15px;"><%= product.name %></div>
            <p style="font-size: 12.5px; color: var(--soft); margin-top: 8px; line-height: 1.4;"><%= product.summary %></p>
          </div>
          <a class="btn btn--ghost" href="/<%= product.slug %>" style="font-size: 11px; min-height: 38px; padding: 0 14px; margin-top: 14px; width: auto; align-self: flex-start;">View Specs ↗</a>
        </div>
      <% }); %>
    <% } else { %>
      <p style="grid-column: span 2; text-align: center; color: var(--soft); padding: 20px 0;">No products in catalogue yet.</p>
    <% } %>
  </div>
</section>

<!-- ============ INNOVATION ============ -->
<section class="section wrap" id="innovation">
  <div class="sec-head">
    <span class="eyebrow">Innovation</span>
    <h2 class="h-sec">Engineering the extra yield.</h2>
    <p class="sec-head__r lede">We mix hardware topologies and digitise operations to squeeze more generation from every roof.</p>
  </div>
  <div class="inno">
    <article class="inno__card reveal">
      <span class="inno__tag">Duo Mix Solution</span>
      <h3 class="inno__h">String + microinverter, on one system.</h3>
      <p class="inno__p">We combine string and microinverters on a single PV solution for maximum generation — ideal for large, multi-facet roofs.</p>
      <figure class="media" style="aspect-ratio: 16/9; margin-top: 20px;">
        <img src="/images/eternalgy-duo-mix-v1.webp" width="1500" height="844" alt="Hybrid solar topology combining string and microinverters" loading="lazy" decoding="async">
      </figure>
    </article>
    <article class="inno__card reveal">
      <span class="inno__tag">Digitalised Logistics</span>
      <h3 class="inno__h">Cloud inventory, automated stock.</h3>
      <p class="inno__p">Cloud invoicing, automated stock-keeping and scheduled delivery across our Southern and Central warehouses.</p>
      <figure class="media media--dashboard" style="aspect-ratio: 16/9; margin-top: 20px;">
        <img src="/images/eternalgy-logistics-dashboard-v1.webp" width="1500" height="844" alt="Cloud inventory and logistics dashboard for solar hardware operations" loading="lazy" decoding="async">
      </figure>
    </article>
  </div>
</section>

<!-- ============ TRACK RECORD ============ -->
<section class="section wrap" id="record" style="background:var(--panel);">
  <div class="sec-head">
    <span class="eyebrow">Achieved milestones</span>
    <h2 class="h-sec">Zero to 1.65&nbsp;MWp in 24 months.</h2>
    <p class="sec-head__r lede">The magnitude accumulates over time — but the pace of growth is the proof of strength. Founded September 2023.</p>
  </div>
  <div class="tl">
    <div class="tl__row reveal"><span class="tl__date">2023 · SEP</span><div class="tl__h">Incorporated as Eternalgy Sdn Bhd</div><p class="tl__d">Officially registered with RM1,000,000 paid-up capital.</p></div>
    <div class="tl__row reveal"><span class="tl__date">2023–24</span><div class="tl__h">Appointed SAJ Malaysia Sole Distributor</div><p class="tl__d">A 50MW + 10MWh PV &amp; ESS agreement formalised in Shanghai.</p></div>
    <div class="tl__row reveal"><span class="tl__date">2024</span><div class="tl__h">SEDA Registered PV Service Provider</div><p class="tl__d">Registered RPVSP — later approved as Registered PV Investor (RPVI).</p></div>
    <div class="tl__row reveal is-peak"><span class="tl__date">10M</span><div class="tl__h">Fastest RPVSP to RM10M revenue</div><p class="tl__d">The fastest of any RPVSP in Malaysia to its first RM10M.</p></div>
    <div class="tl__row reveal"><span class="tl__date">2024</span><div class="tl__h">Outstanding Bull Award</div><p class="tl__d">Golden Bull Award — Outstanding Bull, for 2024 performance.</p></div>
    <div class="tl__row reveal"><span class="tl__date">2025 · MAR</span><div class="tl__h">CIDB Certified — Grade G3</div><p class="tl__d">Categories B (B04), CE (CE21) and ME (M15).</p></div>
    <div class="tl__row reveal is-peak"><span class="tl__date">1.65 MWp</span><div class="tl__h">Commissioned 1.65 MWp of solar PV</div><p class="tl__d">From zero to 1.65 MWp (1,653.55 MWh) deployed in 24 months — and counting.</p></div>
  </div>
</section>

<!-- ============ KNOWLEDGE PORTAL ============ -->
<section class="section wrap" id="news-tips">
  <div class="sec-head">
    <span class="eyebrow">Eternalgy Portal</span>
    <h2 class="h-sec">Solar Tips &amp; Energy News</h2>
    <p class="sec-head__r lede">Engineering guidelines, solar calculator math, and global policy updates.</p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 40px;">
    <!-- Section: Tips -->
    <div>
      <div style="border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: baseline;">
        <h3 class="h-sec" style="font-size: 20px;">Technical Tips</h3>
        <a href="/tips" style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-deep); text-decoration: underline;">View All ↗</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% if (tips && tips.length > 0) { %>
          <% tips.forEach(function(tip) { %>
            <article class="reveal" style="border-bottom: 1px solid var(--line); padding-bottom: 16px;">
              <div style="font-family: var(--font-mono); font-size: 11px; color: var(--soft); margin-bottom: 4px;">
                <%= new Date(tip.created_at).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
              </div>
              <h4 style="font-family: var(--font-display); font-size: 16px; font-weight: 500; margin: 0 0 6px 0;">
                <a href="/<%= tip.slug %>" style="color: var(--ink);"><%= tip.title %></a>
              </h4>
              <p style="font-size: 13.5px; color: var(--soft); margin: 0; line-height: 1.5;"><%= tip.summary %></p>
            </article>
          <% }); %>
        <% } else { %>
          <p style="color: var(--soft);">No tips available.</p>
        <% } %>
      </div>
    </div>

    <!-- Section: News -->
    <div>
      <div style="border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: baseline;">
        <h3 class="h-sec" style="font-size: 20px;">Energy News</h3>
        <a href="/news" style="font-family: var(--font-mono); font-size: 11px; color: var(--accent-deep); text-decoration: underline;">View All ↗</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <% if (news && news.length > 0) { %>
          <% news.forEach(function(item) { %>
            <article class="reveal" style="border-bottom: 1px solid var(--line); padding-bottom: 16px;">
              <div style="font-family: var(--font-mono); font-size: 11px; color: var(--soft); margin-bottom: 4px;">
                <%= new Date(item.created_at).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
              </div>
              <h4 style="font-family: var(--font-display); font-size: 16px; font-weight: 500; margin: 0 0 6px 0;">
                <a href="/<%= item.slug %>" style="color: var(--ink);"><%= item.title %></a>
              </h4>
              <p style="font-size: 13.5px; color: var(--soft); margin: 0; line-height: 1.5;"><%= item.summary %></p>
            </article>
          <% }); %>
        <% } else { %>
          <p style="color: var(--soft);">No news articles available.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ============ PARTNER ============ -->
<section class="section wrap" style="background:var(--ink); color:var(--paper); margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad);">
  <div class="partner">
    <figure class="media media--ink" style="aspect-ratio:4/3; margin-bottom:26px;">
      <img src="/images/eternalgy-saj-partnership-v1.webp" width="1200" height="900" alt="Renewable energy distribution agreement signing in Shanghai" loading="lazy" decoding="async">
    </figure>
    <span class="eyebrow" style="color:#97a09a;">Strategic partnership</span>
    <h2 class="h-sec" style="color:var(--paper); margin-top:16px;">Sole distributor for SAJ in Malaysia.</h2>
    <p class="lede" style="color:#aab2ac; margin-top:18px;">SAJ chose Eternalgy for our rapid market growth and fully integrated, first-party team — from sales and technical consulting to installation and long-term O&amp;M.</p>
    <a class="btn btn--accent" href="#contact" style="margin-top:26px;">Partner with us ↗</a>
  </div>
</section>

<!-- ============ CERTIFICATIONS ============ -->
<section class="cert-band section wrap" id="certs">
  <div class="sec-head">
    <span class="eyebrow">Certification &amp; recognition</span>
    <h2 class="h-sec">Credentials you can verify.</h2>
    <p class="sec-head__r lede">Registered, certified and recognised across Malaysia's renewable-energy ecosystem.</p>
  </div>
  <div class="cert-grid">
    <div class="cert reveal"><div><div class="cert__name">SEDA RPVSP</div><div class="cert__sub">PV Service Provider</div></div><div class="cert__tick">✓ Registered</div></div>
    <div class="cert reveal"><div><div class="cert__name">SEDA RPVI</div><div class="cert__sub">PV Investor</div></div><div class="cert__tick">✓ Approved</div></div>
    <div class="cert reveal"><div><div class="cert__name">CIDB · G3</div><div class="cert__sub">B04 · CE21 · M15</div></div><div class="cert__tick">✓ Certified</div></div>
    <div class="cert reveal"><div><div class="cert__name">MyHijau</div><div class="cert__sub">Certified Equipment</div></div><div class="cert__tick">✓ Listed</div></div>
    <div class="cert reveal"><div><div class="cert__name">Maybank</div><div class="cert__sub">Selected PV Partner</div></div><div class="cert__tick">✓ Appointed</div></div>
    <div class="cert reveal"><div><div class="cert__name">SAJ</div><div class="cert__sub">Sole Distributor</div></div><div class="cert__tick">✓ Exclusive</div></div>
    <div class="cert reveal"><div><div class="cert__name">SHRDC</div><div class="cert__sub">Center of Excellence</div></div><div class="cert__tick">✓ Partner</div></div>
    <div class="cert reveal"><div><div class="cert__name">Golden Bull</div><div class="cert__sub">Outstanding Bull 2024</div></div><div class="cert__tick">✓ Awarded</div></div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="cta section wrap" id="contact" style="margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad);">
  <span class="eyebrow no-tick" style="color:var(--on-accent); opacity:.7;">Get started</span>
  <h2 class="display" style="margin-top:16px;">Let's size your system.</h2>
  <p class="copy">Tell us your roof, your tariff and your goals. Our engineers will come back with a design and a return you can hold us to.</p>
  <div class="cta__actions">
    <a class="btn btn--light" href="https://wa.me/601121000099" target="_blank" rel="noopener">WhatsApp us ↗</a>
    <a class="btn" href="https://wa.me/601121000099" target="_blank" rel="noopener" style="background:transparent;border-color:var(--on-accent);color:var(--on-accent);">Request a quote</a>
  </div>
  <p class="cta__meta">+60 11-2100 0099 · <a href="https://eternalgy.me" target="_blank" rel="noopener">eternalgy.me</a></p>
</section>

<%- include('partials/footer') %>
