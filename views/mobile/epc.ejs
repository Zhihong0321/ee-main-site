<%- include('partials/header') %>

<section class="section wrap">
  <div class="sec-head">
    <span class="eyebrow">Corporate Profile</span>
    <h1 class="h-sec"><%= overview ? overview.title : 'Company Profile' %></h1>
    <p class="sec-head__r lede">Engineering, Procurement, and Construction (EPC) credentials, SEDA RPVSP/RPVI status, and corporate setup nationwide.</p>
  </div>

  <div class="article-body-container" style="padding: 0;">
    <!-- Overview Content -->
    <article class="article-body reveal" style="margin-bottom: 40px;">
      <%- overview ? overview.html_content : '<p>No overview seeded.</p>' %>
    </article>

    <!-- Mission & Vision (Stacked) -->
    <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px;">
      <% if (mission) { %>
        <div class="inno__card reveal" style="border-top: 4px solid var(--accent); padding: 20px;">
          <span class="inno__tag">OUR MISSION</span>
          <h3 class="inno__h" style="font-size: 20px; margin-top: 8px;"><%= mission.title %></h3>
          <div style="font-size: 14.5px; color: var(--ink-2); margin-top: 10px; line-height: 1.5;">
            <%- mission.html_content %>
          </div>
        </div>
      <% } %>
      <% if (vision) { %>
        <div class="inno__card reveal" style="border-top: 4px solid var(--accent-deep); padding: 20px;">
          <span class="inno__tag">OUR VISION</span>
          <h3 class="inno__h" style="font-size: 20px; margin-top: 8px;"><%= vision.title %></h3>
          <div style="font-size: 14.5px; color: var(--ink-2); margin-top: 10px; line-height: 1.5;">
            <%- vision.html_content %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Certifications Table -->
    <section class="reveal" style="margin-bottom: 48px;">
      <div style="border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 16px;">
        <h2 class="h-sec" style="font-size: 22px;">Licenses &amp; Accreditations</h2>
      </div>
      
      <div style="display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; min-width: 450px; background: var(--panel);">
          <thead>
            <tr style="background: var(--panel-2);">
              <th style="padding: 12px; text-align: left; font-family: var(--font-mono); font-size: 11px; color: var(--ink); text-transform: uppercase; width: 40%;">License</th>
              <th style="padding: 12px; text-align: left; font-family: var(--font-mono); font-size: 11px; color: var(--ink); text-transform: uppercase;">Governing Body</th>
              <th style="padding: 12px; text-align: left; font-family: var(--font-mono); font-size: 11px; color: var(--ink); text-transform: uppercase;">License No.</th>
            </tr>
          </thead>
          <tbody>
            <% certifications.forEach(function(cert) { %>
              <tr style="border-bottom: 1px solid var(--line);">
                <td style="padding: 12px; font-size: 13.5px; color: var(--ink); font-weight: 500;"><%= cert.name %></td>
                <td style="padding: 12px; font-size: 13px; color: var(--soft);"><%= cert.body %></td>
                <td style="padding: 12px; font-size: 12.5px; font-family: var(--font-mono); color: var(--ink-2);"><%= cert.license_number || 'N/A' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Branches (Stacked layout) -->
    <section class="reveal" style="margin-bottom: 40px;">
      <div style="border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 20px;">
        <h2 class="h-sec" style="font-size: 22px;">Branches &amp; Warehouses</h2>
      </div>
      
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <% branches.forEach(function(branch) { %>
          <div class="inno__card reveal" style="padding: 20px; background: var(--panel);">
            <span class="inno__tag">LOCATION</span>
            <h3 class="inno__h" style="font-size: 18px; margin-top: 6px;"><%= branch.name %></h3>
            <p style="font-size: 13.5px; color: var(--ink-2); margin-top: 8px; line-height: 1.5;"><%= branch.address %></p>
            
            <div style="font-family: var(--font-mono); font-size: 11.5px; color: var(--soft); margin-top: 14px; display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--line); padding-top: 10px;">
              <span>Phone: <a href="tel:<%= branch.phone %>" style="color: var(--accent-deep); text-decoration: underline;"><%= branch.phone %></a></span>
              <span>Email: <a href="mailto:<%= branch.email %>" style="color: var(--accent-deep); text-decoration: underline;"><%= branch.email %></a></span>
              <span>Coords: <%= branch.latitude %>, <%= branch.longitude %></span>
            </div>
            
            <a href="https://www.google.com/maps/search/?api=1&query=<%= branch.latitude %>,<%= branch.longitude %>" target="_blank" rel="noopener" class="btn btn--ghost" style="margin-top: 16px; font-size: 11px; min-height: 40px; display: flex; align-items: center; justify-content: center; width: 100%;">Get Directions ↗</a>
          </div>
        <% }); %>
      </div>
    </section>
  </div>
</section>

<%- include('partials/footer') %>
