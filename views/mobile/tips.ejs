<%- include('partials/header') %>

<section class="section wrap">
  <div class="sec-head">
    <span class="eyebrow">Engineering Guidelines</span>
    <h1 class="h-sec">Solar Tips</h1>
    <p class="sec-head__r lede">Explore our repository of engineering calculations, mounting parameters, roof warranty advice, and best practices.</p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 24px; margin-top: 24px;">
    <% if (tips && tips.length > 0) { %>
      <% tips.forEach(function(tip) { %>
        <article class="inno__card reveal" style="padding: 20px; background: var(--panel);">
          <div style="font-family: var(--font-mono); font-size: 11px; color: var(--soft); margin-bottom: 6px;">
            BY <%= tip.author %> · <%= new Date(tip.created_at).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
          </div>
          <h2 style="font-family: var(--font-display); font-size: 18px; font-weight: 500; margin: 0 0 8px 0; line-height: 1.3;">
            <a href="/<%= tip.slug %>" style="color: var(--ink);"><%= tip.title %></a>
          </h2>
          <p style="font-size: 13.5px; color: var(--soft); margin: 0 0 16px 0; line-height: 1.5;"><%= tip.summary %></p>
          <a class="btn btn--ghost" href="/<%= tip.slug %>" style="font-size: 11px; min-height: 40px; display: flex; align-items: center; justify-content: center; width: 100%;">Read Full Tip ↗</a>
        </article>
      <% }); %>
    <% } else { %>
      <div class="inno__card" style="text-align: center; padding: 32px;">
        <p style="color: var(--soft);">No tips available. Check back as our engineering agents release updates!</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
