<%- include('partials/header') %>

<section class="section wrap">
  <nav aria-label="Breadcrumb" style="font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-2); margin-bottom: 18px; display: flex; flex-wrap: wrap; gap: 4px;">
    <a href="/agent" style="color: var(--accent-deep);">Service Areas</a><span>/</span>
    <span><%= st.stateName %></span>
  </nav>

  <div class="sec-head">
    <span class="eyebrow"><%= st.townCount %> service areas</span>
    <h1 class="h-sec"><span class="mark">Solar PV in <%= st.stateName %></span></h1>
    <p style="margin: 10px 0 0; font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--ink); line-height: 1.3;">
      <span class="mark"><%= st.stateName %> 太阳能</span>
    </p>
    <p class="sec-head__r lede">Eternalgy's area representatives serve <%= st.townCount %> towns across <%= st.stateName %>, Malaysia. Find your town below.</p>
  </div>

  <div style="display: grid; gap: 24px; margin-top: 24px;">
    <% st.districts.forEach(function(d) { if (d.towns && d.towns.length) { %>
      <div class="reveal" style="border-top: 1px solid var(--line); padding-top: 16px;">
        <span class="eyebrow no-tick" style="font-size: 11px; color: var(--accent-deep); margin-bottom: 12px; display:block;"><%= d.district %></span>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          <% d.towns.forEach(function(t) { %>
            <a class="btn btn--ghost" style="font-size: 12.5px; padding: 8px 12px;" href="/agent/<%= t.stateSlug %>/<%= t.townSlug %>"><%= t.town %></a>
          <% }); %>
        </div>
      </div>
    <% } }); %>
  </div>
</section>

<%- include('partials/footer') %>
