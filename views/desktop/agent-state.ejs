<%- include('partials/header') %>

<section class="section" style="padding-top: clamp(56px, 8vw, 96px);">
  <div class="wrap">
    <nav aria-label="Breadcrumb" style="font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-2); margin-bottom: 28px; display: flex; flex-wrap: wrap; gap: 6px;">
      <a href="/" style="color: var(--accent-deep);">Home</a><span>/</span>
      <a href="/agent" style="color: var(--accent-deep);">Service Areas</a><span>/</span>
      <span><%= st.stateName %></span>
    </nav>

    <div class="sec-head">
      <div>
        <span class="eyebrow">Service areas · <%= st.townCount %> towns</span>
        <h1 class="display" style="margin-top:22px; font-size: clamp(34px, 5vw, 60px);">Solar PV in <%= st.stateName %></h1>
      </div>
      <p class="sec-head__r lede">Eternalgy's area representatives serve <%= st.townCount %> towns across <%= st.stateName %>, Malaysia. Find your town below and call the named representative for a free solar quote.</p>
    </div>

    <div style="display: grid; gap: 48px; margin-top: 48px;">
      <% st.districts.forEach(function(d) { if (d.towns && d.towns.length) { %>
        <div class="reveal" style="border-top: 1px solid var(--line); padding-top: 32px;">
          <span class="eyebrow no-tick" style="font-size: 13px; color: var(--accent-deep); margin-bottom: 20px; display:block;"><%= d.district %></span>
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            <% d.towns.forEach(function(t) { %>
              <a class="btn btn--ghost" style="font-size: 13.5px; padding: 10px 16px;" href="/agent/<%= t.stateSlug %>/<%= t.townSlug %>"><%= t.town %></a>
            <% }); %>
          </div>
        </div>
      <% } }); %>
    </div>
  </div>
</section>

<section class="cta section" id="contact">
  <div class="wrap">
    <div class="cta__grid">
      <div>
        <span class="eyebrow no-tick" style="color:var(--on-accent); opacity:.7;">Get started</span>
        <h2 class="display" style="margin-top:18px;">Solar PV<br>in <%= st.stateName %>.</h2>
      </div>
      <div>
        <p style="font-size:19px; line-height:1.5; max-width:38ch;">Tell us your roof, your tariff and your goals. Our engineers will come back with a system design and a return you can hold us to.</p>
        <div class="hero__actions" style="margin-top:26px;">
          <a class="btn btn--light" href="https://wa.me/601121000099" target="_blank" rel="noopener">WhatsApp us <span class="arrow">↗</span></a>
          <a class="btn" href="https://wa.me/601121000099" target="_blank" rel="noopener" style="background:transparent;border-color:var(--on-accent);color:var(--on-accent);">Request a quote</a>
        </div>
        <p class="cta__meta" style="margin-top:24px;">+60 11-2100 0099 &nbsp;·&nbsp; <a href="https://eternalgy.me" target="_blank" rel="noopener">eternalgy.me</a></p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
