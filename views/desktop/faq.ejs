<%- include('partials/header') %>

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Frequently Asked Questions</span>
        <h1 class="display" style="margin-top:22px; font-size: clamp(32px, 5vw, 56px);">Solar PV FAQ</h1>
      </div>
      <p class="sec-head__r lede">Everything you need to know about solar PV installations in Malaysia—covering the Solar ATAP framework, SuRIA Home cash rebates, three-phase grid conversions, Monier roof warranties, and system lifetimes.</p>
    </div>

    <% const catNames = {
      financial: '💰 Financial Viability & Payback Projections',
      technical: '⚙️ Technical Prerequisites & Maintenance',
      structural: '🏠 Structural Integrity & Leakage Prevention',
      policy: '📋 Policy Transitions (Solar ATAP & NEM)'
    } %>

    <div style="display: grid; gap: 48px; margin-top: 48px;">
      <% Object.entries(grouped).forEach(function([category, list]) { %>
        <% if (list && list.length > 0) { %>
          <div class="reveal" style="border-top: 1px solid var(--line); padding-top: 32px;">
            <span class="eyebrow no-tick" style="font-size: 13px; color: var(--accent-deep); margin-bottom: 24px;"><%= catNames[category] || category.toUpperCase() %></span>
            
            <div style="display: grid; gap: 24px; margin-top: 16px;">
              <% list.forEach(function(faq) { %>
                <article style="background: var(--panel); border: 1px solid var(--line); padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; gap: 16px;">
                  <h3 style="font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--ink); line-height: 1.3; display: flex; gap: 12px; align-items: flex-start; margin: 0;">
                    <span style="font-family: var(--font-mono); font-size: 14px; color: var(--accent-deep); background: var(--paper); padding: 2px 8px; border: 1px solid var(--line); border-radius: 4px; flex-shrink: 0;">Q</span>
                    <%= faq.question %>
                  </h3>
                  <div class="article-body" style="border-left: 2px solid var(--line-strong); padding-left: 20px; margin-left: 14px; font-size: 15.5px; color: var(--ink-2); line-height: 1.6;">
                    <%- faq.html_answer %>
                  </div>
                </article>
              <% }); %>
            </div>
          </div>
        <% } %>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
