<%- include('partials/header') %>

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Executed Track Record · <%= project.location %></span>
        <h1 class="display" style="margin-top:22px; font-size: clamp(32px, 5vw, 56px);"><%= project.title %></h1>
      </div>
      <p class="sec-head__r lede"><%= project.summary %></p>
    </div>

    <div class="article-body-container" style="max-width: 960px; margin: 48px auto 0 auto;">
      <!-- Project Summary Stat Card -->
      <div class="inno__card reveal" style="border-top: 4px solid var(--accent); margin-bottom: 56px; padding: 32px; background: var(--panel);">
        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 32px; align-items: center;">
          <div style="text-align: center; border-right: 1px solid var(--line); padding-right: 32px;">
            <span class="eyebrow no-tick" style="font-size: 11px; margin-bottom: 8px;">CAPACITY</span>
            <div style="font-family: var(--font-display); font-size: 36px; font-weight: 500; color: var(--ink); margin-top: 8px;">
              <%= project.capacity_kwp %><span style="font-size: 16px; color: var(--accent-deep); font-family: var(--font-mono); font-weight: 600; margin-left: 4px;">kWp</span>
            </div>
          </div>
          <div>
            <span class="eyebrow no-tick" style="font-size: 11px; margin-bottom: 8px;">CLIENT PARTNER</span>
            <div style="font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--ink); margin-top: 8px;">
              <%= project.client_name || 'Commercial Solar Partner' %>
            </div>
            <% if (project.commission_date) { %>
              <div style="font-family: var(--font-mono); font-size: 12.5px; color: var(--soft); margin-top: 8px;">
                COMMISSIONED: <%= new Date(project.commission_date).toLocaleDateString('en-US', {month: 'long', year: 'numeric'}) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Case Study Details -->
      <article class="article-body reveal">
        <%- project.html_details %>
      </article>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
