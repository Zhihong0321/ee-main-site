<%- include('partials/header') %>

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Engineering Guidelines</span>
        <h1 class="display" style="margin-top:22px; font-size: clamp(32px, 5vw, 56px);">Solar Tips</h1>
      </div>
      <p class="sec-head__r lede">Explore our repository of engineering calculations, mounting parameters, roof warranty advice, and best practices for commercial and utility solar design.</p>
    </div>

    <div style="max-width: 900px; margin: 48px auto 0 auto; display: flex; flex-direction: column; gap: 32px;">
      <% if (tips && tips.length > 0) { %>
        <% tips.forEach(function(tip) { %>
          <article class="inno__card reveal" style="border: 1px solid var(--line); background: var(--panel); padding: clamp(24px, 3vw, 40px); justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-mono); font-size: 12px; color: var(--soft); margin-bottom: 8px;">
                BY <%= tip.author %> · <%= new Date(tip.created_at).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>
              </div>
              <h2 style="font-family: var(--font-display); font-size: clamp(20px, 2.2vw, 28px); font-weight: 500; margin: 0 0 12px 0; line-height: 1.25;">
                <a href="/<%= tip.slug %>" style="color: var(--ink);"><%= tip.title %></a>
              </h2>
              <p style="font-size: 16px; color: var(--ink-2); line-height: 1.5; margin: 0 0 24px 0;"><%= tip.summary %></p>
            </div>
            <a class="btn btn--ghost" href="/<%= tip.slug %>" style="align-self: flex-start; font-size: 12px; padding: 10px 18px;">Read Full Tip <span class="arrow">↗</span></a>
          </article>
        <% }); %>
      <% } else { %>
        <div class="inno__card" style="text-align: center; padding: 48px;">
          <p style="color: var(--soft);">No tips available. Check back as our engineering agents release updates!</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
