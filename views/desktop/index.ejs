      <div class="cert reveal"><div><div class="cert__name">CIDB · Grade G3</div><div class="cert__sub">B04 · CE21 · M15</div></div><div class="cert__tick">✓ Certified</div></div>
      <div class="cert reveal"><div><div class="cert__name">MyHijau</div><div class="cert__sub">Certified Equipment — SAJ Inverter</div></div><div class="cert__tick">✓ Listed</div></div>
